p al=0.01,be=0.5,gm=0.14285714285,eps=0.14285714285
p tha=0.01,thb=0.01,kap=1000,rho=0.01,phi=0.5,psi=0.5

s1'=al*(psi-s1-i1) - be*s1*(i1+phi*i2) - eps*v1*s1
i1'=be*s1*(i1+phi*I2) - gm*I1
v1'=1-heav(-(be*(I1+phi*i2) - rho - tha*(1-2*v1))) - v1

s2'=al*(1-psi-s2-i2) - be*s2*(phi*i1+i2) - eps*v2*S2
i2'=be*S2*(phi*i1+i2) - gm*i2
v2'=1-heav(-(be*(phi*i1+i2) - rho - thb*(1-2*v2))) - v2

s1(0)=0.49
i1(0)=0.01
v1(0)=0.01
s2(0)=0.5
i2(0)=0.0
v2(0)=0.01
    
aux switch1=(be*(phi*i2+i1) - rho - thb*(1-2*v1))
aux switch2=(be*(phi*i1+i2) - rho - thb*(1-2*v2))

@ total=1000
