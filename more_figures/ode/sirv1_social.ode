# uncoupled smooth SIRV model

p kap=300,al=0.01,be=0.5,gm=0.14285714285,eta=0.14285714285
p delta=0.01,rho=0.01

S'=al*(1-S-I) - be*S*I - eta*v*S
I'=-gm*I + be*S*I
v'=-v+1/(1+exp(-kap*(be*I - rho - delta*(1-2*v))))

S(0)=0.98
I(0)=0.01
v(0)=0.01

@ dt=0.01, total=500
@ parmin=0,parmax=1000,dsmin=1e-8