p a=0, b=0, eps=.02
TT=86.91035377395296
s=TT/(2*pi)
k=-0.032890098538026075
h1p0(x)=0.4686+2*cos(x*1.0)*(-0.0447)+2*cos(x*2.0)*(-0.0619)+2*cos(x*3.0)*(-0.0466)
h1p1(x)=2*cos(x*4.0)*(-0.0136)+2*cos(x*6.0)*(-0.0103)+2*cos(x*7.0)*(-0.0217)+2*cos(x*8.0)*(-0.0179)
h1p2(x)=2*cos(x*9.0)*(-0.0064)+2*cos(x*11.0)*(-0.0014)+2*cos(x*12.0)*(-0.0039)
h1p3(x)=2*cos(x*13.0)*(-0.0035)+2*cos(x*14.0)*(-0.0015)-2*sin(x*1.0)*(-0.1366)
h1p4(x)=-2*sin(x*2.0)*(-0.1609)-2*sin(x*3.0)*(-0.0952)-2*sin(x*4.0)*(-0.0266)-2*sin(x*6.0)*(-0.0023)
h1p5(x)=-2*sin(x*7.0)*(-0.0055)-2*sin(x*8.0)*(-0.0037)-2*sin(x*9.0)*(-0.0014)-2*sin(x*11.0)*(0.0011)
h1p6(x)=-2*sin(x*12.0)*(0.0024)-2*sin(x*13.0)*(0.0022)
h1(x)=h1p0(x)+h1p1(x)+h1p2(x)+h1p3(x)+h1p4(x)+h1p5(x)+h1p6(x)
h7(x)=-0.5346
# oscillator 0 (at phi)  carries heterogeneity delta
# oscillator 1 (at -phi)

phi'=s*(eps*(1-a)*h1(-phi)-eps*(1+a)*h1(phi)-b*h7(0))

@ total=100,dt=0.02
@ dsmax=.01,dsmin=1e-5,ds=.001
@ parmin=-10,parmax=10

d
