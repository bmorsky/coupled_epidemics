p a=0, b=0, eps=.02
TT=86.91035377395296
s=TT/(2*pi)
k=-0.032890098538026075
h1p0(x)=1.7130+2*cos(x*1.0)*(-0.6848)+2*cos(x*2.0)*(-0.0482)+2*cos(x*3.0)*(-0.0418)
h1p1(x)=2*cos(x*4.0)*(-0.0096)+2*cos(x*6.0)*(-0.0121)+2*cos(x*7.0)*(-0.0234)+2*cos(x*8.0)*(-0.0187)
h1p2(x)=2*cos(x*9.0)*(-0.0065)+2*cos(x*11.0)*(-0.0014)+2*cos(x*12.0)*(-0.0039)
h1p3(x)=2*cos(x*13.0)*(-0.0036)+2*cos(x*14.0)*(-0.0015)-2*sin(x*1.0)*(-0.6401)
h1p4(x)=-2*sin(x*2.0)*(-0.2255)-2*sin(x*3.0)*(-0.1206)-2*sin(x*4.0)*(-0.0303)-2*sin(x*5.0)*(0.0012)
h1p5(x)=-2*sin(x*7.0)*(-0.0054)-2*sin(x*8.0)*(-0.0041)-2*sin(x*9.0)*(-0.0016)-2*sin(x*11.0)*(0.0012)
h1p6(x)=-2*sin(x*12.0)*(0.0024)-2*sin(x*13.0)*(0.0022)
h1(x)=h1p0(x)+h1p1(x)+h1p2(x)+h1p3(x)+h1p4(x)+h1p5(x)+h1p6(x)
h7(x)=-0.5346
# oscillator 0 (at phi)  carries heterogeneity delta
# oscillator 1 (at -phi)

phi'=s*(eps*(1-a)*h1(-phi)-eps*(1+a)*h1(phi)-b*h7(0))

@ total=100,dt=0.02
@ dsmax=.01,dsmin=1e-5,ds=.001
@ parmin=-10,parmax=10

d
