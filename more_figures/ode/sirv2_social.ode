# uncoupled smooth SIRV model

p a=0,b=0,eps=0.01
p kap=300,al=0.01,be=0.5,gm=0.14285714285,eta=0.14285714285
p delta=0.01,rho=0.01

s1'=al*(1-s1-i1) - be*s1*i1 - (eta+b)*v1*s1
i1'=-gm*i1 + be*s1*i1
v1'=-v1+1/(1+exp(-kap*(be*i1 - rho - delta*(1-2*vtilde1))))
vtilde1=(1-eps*(1+a))*v1+eps*(1+a)*v2


s2'=al*(1-s2-i2) - be*s2*i2 - eta*v2*s2
i2'=-gm*i2 + be*s2*i2
v2'=-v2+1/(1+exp(-kap*(be*i2 - rho - delta*(1-2*vtilde2))))
vtilde2=(1-eps*(1-a))*v2+eps*(1-a)*v1


s1(0)=0.4
i1(0)=0.03
v1(0)=0.01

s2(0)=0.41
i2(0)=0.02
v2(0)=0.01



@ dt=0.01, total=500
@ parmin=0,parmax=1000,dsmin=1e-8